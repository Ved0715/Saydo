{
  "name": "saydo",
  "version": "0.1.0",
  "description": "Say it. It's done. The AI-native framework for React and Next.js: your users can ask, and your app does it \u2014 everything they can see and do, with consent the model cannot bypass.",
  "keywords": [
    "ai",
    "react",
    "nextjs",
    "vite",
    "agent",
    "assistant",
    "llm",
    "copilot",
    "ai-sdk",
    "mcp",
    "framework"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "saydo": "./bin/saydo.mjs"
  },
  "exports": {
    ".": {
      "saydo-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "saydo-source": "./src/server.ts",
      "types": "./dist/types/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./config": {
      "saydo-source": "./src/config.ts",
      "types": "./dist/types/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./handler": {
      "saydo-source": "./src/handler.ts",
      "types": "./dist/types/handler.d.ts",
      "import": "./dist/handler.js",
      "default": "./dist/handler.js"
    },
    "./react": {
      "saydo-source": "./src/react.ts",
      "types": "./dist/types/react.d.ts",
      "import": "./dist/client/react.js",
      "default": "./dist/client/react.js"
    },
    "./react-router": {
      "saydo-source": "./src/react-router.tsx",
      "types": "./dist/types/react-router.d.ts",
      "import": "./dist/client/react-router.js",
      "default": "./dist/client/react-router.js"
    },
    "./next": {
      "saydo-source": "./src/next.ts",
      "types": "./dist/types/next.d.ts",
      "require": "./dist/next.cjs",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./next/client": {
      "saydo-source": "./src/next-client.tsx",
      "types": "./dist/types/next-client.d.ts",
      "import": "./dist/client/next-client.js",
      "default": "./dist/client/next-client.js"
    },
    "./next/server": {
      "saydo-source": "./src/next-server.ts",
      "types": "./dist/types/next-server.d.ts",
      "import": "./dist/next-server.js",
      "default": "./dist/next-server.js"
    },
    "./next/route": {
      "saydo-source": "./src/next-route.ts",
      "types": "./dist/types/next-route.d.ts",
      "import": "./dist/next-route.js",
      "default": "./dist/next-route.js"
    },
    "./vite": {
      "saydo-source": "./src/vite.ts",
      "types": "./dist/types/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./node": {
      "saydo-source": "./src/node.ts",
      "types": "./dist/types/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./registry": {
      "saydo-source": "./src/registry.ts",
      "types": "./dist/types/registry.d.ts",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    },
    "./next/mcp": {
      "saydo-source": "./src/next-mcp.ts",
      "types": "./dist/types/next-mcp.d.ts",
      "import": "./dist/next-mcp.js",
      "default": "./dist/next-mcp.js"
    },
    "./next/approve": {
      "saydo-source": "./src/next-approve.tsx",
      "types": "./dist/types/next-approve.d.ts",
      "import": "./dist/client/next-approve.js",
      "default": "./dist/client/next-approve.js"
    },
    "./dom": {
      "saydo-source": "./src/dom.ts",
      "types": "./dist/types/dom.d.ts",
      "import": "./dist/dom/dom.js",
      "default": "./dist/dom/dom.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "next": ">=15.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": ">=7.0.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/mcp": "2.0.78",
    "@electric-sql/pglite": "0.5.10",
    "@trpc/server": "11.19.0",
    "ai": "7.0.143",
    "esbuild": "0.28.2",
    "firebase-admin": "14.5.0",
    "next": "16.4.2",
    "react-router": "8.4.0",
    "redis": "6.3.0",
    "vite": "8.3.4"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
