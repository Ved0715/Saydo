{
  "name": "saydo-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "build": "pnpm --filter saydo build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "templates": "node packages/create-saydo-app/scripts/sync-templates.mjs",
    "demo": "pnpm --filter next-demo dev",
    "demo:react": "pnpm --filter vite-demo dev",
    "pack": "pnpm build && cd packages/saydo && npm pack && cd ../create-saydo-app && npm pack"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
